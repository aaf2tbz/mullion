@@ -2687,6 +2687,14 @@
     cmd.dst = dst;
     cmd.dst_offset = AlignedDstBufferOffset;
     cmd.copy_length = uint64_t(QueryCount) * heap->result_size;
+    if (Type == D3D12_QUERY_TYPE_PIPELINE_STATISTICS || Type == D3D12_QUERY_TYPE_PIPELINE_STATISTICS1) {
+      auto &clear = allocator_->EncodeBlitCommand<wmtcmd_blit_fillbuffer>();
+      clear.type = WMTBlitCommandFillBuffer;
+      clear.buffer = heap->results;
+      clear.offset = cmd.src_offset;
+      clear.length = cmd.copy_length;
+      clear.value = 0;
+    }
   };
 
