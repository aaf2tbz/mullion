# classifies only quiet NaNs and misses signaling encodings
--- a/src/airconv/dxil_converter.cpp
+++ b/src/airconv/dxil_converter.cpp
@@ -3310,9 +3310,13 @@
     case Round_z:
       ret = fp_unary(llvm::air::AIRBuilder::trunc, a(1));
       break;
-    case IsNaN:
-      ret = air.CreateIsNaN(a(1));
-      break;
+    case IsNaN: {
+      unsigned width = a(1)->getType()->isHalfTy() ? 16 : 32;
+      auto bits = ir.CreateBitCast(a(1), ir.getIntNTy(width));
+      auto quiet = ir.getIntN(width, uint64_t(1) << (width == 16 ? 9 : 22));
+      ret = ir.CreateAnd(air.CreateIsNaN(a(1)), ir.CreateICmpNE(ir.CreateAnd(bits, quiet), ir.getIntN(width, 0)));
+      break;
+    }
     case IsInf:
       ret = ir.CreateFCmpOEQ(fp_unary(llvm::air::AIRBuilder::fabs, a(1)), ConstantFP::getInfinity(a(1)->getType()));
       break;
